DATABASE_URL=postgresql+psycopg://swipex:swipex_pass@localhost:5433/swipex
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

IMPORT_ENABLED=true
IMPORT_INTERVAL_MINUTES=15

# Optional: free keys from developer.adzuna.com switch on the aggregator import
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Any OpenAI-compatible AI service works (Groq, Gemini, OpenRouter, Ollama)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=

# Import every job from every company board (set false to keep only India tech roles)
IMPORT_ALL_JOBS=true
# Countries for the optional Adzuna import
ADZUNA_COUNTRIES=in,gb,us,ca,au,de,sg
