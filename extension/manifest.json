{
  "manifest_version": 3,
  "name": "SwipeX Autofill",
  "version": "0.1.0",
  "description": "Fills job application forms with your SwipeX details. You always review and submit yourself.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "http://localhost:5173/autofill-test.html*",
        "http://127.0.0.1:5173/autofill-test.html*"
      ],
      "js": ["fill.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}